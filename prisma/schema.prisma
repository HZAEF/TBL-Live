generator client {
  provider = "prisma-client-js"
}

// Pré-configuré pour Neon (PostgreSQL) — version en ligne.
// Pour un essai LOCAL hors ligne uniquement : remplacez
// « postgresql » par « sqlite » puis suivez la section « mode
// local » du LISEZMOI.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TBL Live — Team-Based Learning
// Une Session = une séance TBL complète (iRAT, tRAT,
// réclamations, application, évaluation par les pairs)
// ============================================================

model Session {
  id            String   @id @default(cuid())
  code          String   @unique // code à 6 caractères pour rejoindre
  title         String
  teacherPin    String // code PIN enseignant (haché bcrypt, 6 caractères et plus)
  teacherToken  String // jeton secret enseignant (accès tableau de bord)
  status        String   @default("lobby") // lobby | irat | trat | appeal | feedback | application | peer | finished
  iratMinutes   Int      @default(10) // durée conseillée du iRAT
  phaseStartedAt DateTime @default(now()) // début de la phase en cours
  revealed      Boolean  @default(false) // révélation simultanée des réponses d'application
  // v2.7.0 : écran d'attente avant le feedback — entre les réclamations et
  // le feedback, les étudiants voient une page neutre (aucun résultat, rien
  // à capturer) tant que l'enseignant n'a pas cliqué « Lancer le feedback ».
  feedbackReady Boolean  @default(false)
  // v2.7.0 : date du dernier modifications des paramètres (fusion Internet
  // ↔ réseau local : dernier écrit gagne, colonne additive nullable).
  updatedAt     DateTime?
  // v2.7.0 : date de la dernière synchronisation réussie avec la version
  // en ligne (affichée dans l'onglet Configurations, null = jamais).
  syncedAt      DateTime?
  // Protection anti force-brute du PIN enseignant (Vercel est serverless :
  // la mémoire ne persiste pas entre les requêtes, on stocke donc en base).
  // 5 tentatives fausses → verrouillage temporaire de 15 minutes.
  pinAttempts    Int      @default(0)
  pinLockedUntil DateTime?
  // Corbeille : suppression « douce » demandée par l'enseignant. Les étudiants
  // perdent immédiatement l'accès ; l'enseignant peut restaurer la séance
  // pendant 48 h ; au-delà, elle est supprimée définitivement.
  deletedAt      DateTime?
  // Purge automatique : 4 mois après la création, les données produites par
  // les étudiants (noms, réponses, réclamations, évaluations par les pairs)
  // sont effacées — la séance (QCM, cas cliniques, réglages) est conservée.
  dataPurgedAt   DateTime?
  // v2.9.0 — Sondage allégé pour les grandes classes. Chaque écriture qui
  // change ce que voient les ÉTUDIANTS (phase, question, réponse, équipe,
  // révélation…) incrémente « revision » : un étudiant qui renvoie son
  // dernier numéro reçoit une réponse minuscule « rien n'a changé » au
  // lieu de l'état complet. Divise la charge de la base quand rien ne
  // bouge (65 étudiants = 65 réponses légères au lieu de 65 états
  // complets à chaque cycle).
  revision       Int      @default(0)
  // v2.9.0 — Même principe pour le tableau de bord ENSEIGNANT : compteur
  // séparé, incrémenté AUSSI par les signalements anti-capture (visibles
  // par l'enseignant, sans intérêt pour les étudiants → pas de « revision »).
  revisionTeacher Int     @default(0)
  // v3.0.0 — Compte enseignant propriétaire de la séance (null = séance
  // importée par synchronisation ou créée avant la v3.0 : aucune perte,
  // la séance reste pilotable par code + PIN). Colonne additive nullable.
  teacherId      String?
  teacher        TeacherAccount? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  // v3.0.0 — Signalements anti-capture : DÉSACTIVÉS par défaut (la
  // professeure ne les juge plus pertinents) ; l'administrateur peut les
  // réactiver TBL par TBL depuis /admin. Quand ils sont désactivés :
  // rien n'est envoyé depuis les téléphones, rien n'est écrit en base,
  // l'onglet « Signalements » disparaît du tableau de bord et la requête
  // des événements n'est plus exécutée — la séance reste légère même
  // avec 150 étudiants. Colonne additive, défaut false (désactivé).
  reportsEnabled Boolean  @default(false)
  // v3.1.0 — Journal d'événements (préparation de la synchronisation
  // delta hybride) : numéro du DERNIER événement consigné pour la
  // séance. Chaque mutation importante (réponse, join, changement de
  // phase, révélation…) ajoute UNE ligne SessionEvent numérotée —
  // un futur sync pourra demander « les événements après le curseur N »
  // au lieu de transporter le snapshot complet. Colonne additive,
  // défaut 0 (les séances existantes démarrent simplement à zéro).
  eventSeq       Int      @default(0)
  createdAt     DateTime @default(now())

  teams    Team[]
  students Student[]
  questions Question[]
  cases    Case[]
  appeals  Appeal[]
  peerEvals PeerEval[]
  // v2.6.0 : questionnaire de fin de séance (TBL-SAI) propre à la séance
  saiItems  SaiItem[]
  // v3.1.0 : journal d'événements (synchronisation delta future)
  events   SessionEvent[]
}

// ============================================================
// v3.1.0 — Journal d'événements d'une séance
//
// PRÉPARATION de la synchronisation delta « hybride » : chaque
// mutation importante ajoute UNE ligne numérotée (sequence monotone
// propre à la séance, attribuée sous le verrou d'écriture → jamais
// deux événements avec le même numéro). Un futur mécanisme de
// synchronisation pourra demander « donne-moi les événements après
// le curseur X » (action export_events) au lieu de transporter le
// snapshot complet — le snapshot reste nécessaire pour le backup,
// la restauration et l'amorçage d'une nouvelle instance.
//
// RÈGLES :
//  - INSERT-ONLY : on n'écrit JAMAIS de mise à jour ni de suppression
//    (une correction apparaît comme un NOUVEL événement) ;
//  - AUCUN SECRET dans payload (jamais de jeton, de PIN, de code de
//    reprise, de mot de passe — uniquement des identifiants techniques
//    et des valeurs de réponse) ;
//  - origin : instance qui a produit l'événement ('local' | 'online'),
//    pour diagnostiquer les allers-retours de la fusion hybride ;
//  - volume négligeable : ~1 ligne par mutation étudiante (quelques
//    dizaines d'octets), écrite DANS le verrou d'écriture de la
//    séance → zéro contention supplémentaire.
// ============================================================
model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Numéro monotone propre à la séance (1, 2, 3…). Attribué en
  // incrémentant Session.eventSeq SOUS le verrou d'écriture : deux
  // écritures simultanées ne peuvent pas produire le même numéro.
  sequence  Int
  // 'join' | 'answer' | 'team_answer' | 'app_answer' | 'appeal' |
  // 'appeal_done' | 'peer' | 'sai' | 'phase' | 'case_open' | 'reveal'
  // | 'finish' | 'appeal_decision'
  type      String
  // Identifiant de l'entité concernée (id de la question, de l'étudiant,
  // de l'équipe, du cas…) — null pour les événements de séance entière.
  entityId  String?
  // JSON minimal SANS secret (choix, tentative, phase, textes courts).
  payload   String   @default("{}")
  // Instance émettrice : 'local' (le PC de l'enseignant) ou 'online'
  // (Vercel). Renseigné depuis l'en-tête x-tbl-origin du POST (si
  // absent : 'local' — le serveur qui traite est l'origine).
  origin    String   @default("local")
  createdAt DateTime @default(now())

  // Un numéro par séance, et un seul : garanti même si deux requêtes
  // concurrentes arrivaient à lire le même eventSeq (sécurité
  // secondaire, le verrou applicatif tient déjà le terrain).
  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
}

// ============================================================
// v3.0.0 — Comptes enseignants (connexion obligatoire)
// Seul un compte créé par l'administrateur peut ouvrir des séances
// TBL (créer, reprendre, téléverser) : plus de séance ouverte par
// n'importe qui. Connexion par email institutionnel + mot de passe
// (généré par l'administrateur, modifiable par l'enseignant).
//  - email : unique, minuscules, domaine institutionnel vérifié
//    (@famso.u-sousse.tn par défaut, modifiable dans /admin) ;
//  - passwordHash : bcrypt (comme le PIN et le mot de passe admin) ;
//  - jeton de session : cookie HttpOnly, SEUL le hash SHA-256 est
//    stocké en base (12 h), verrouillage 5 essais → 15 minutes ;
//  - forgotPasswordAt : l'enseignant a signalé un mot de passe
//    oublié → badge dans l'espace Comptes de l'administrateur, qui
//    génère un nouveau mot de passe et le lui envoie par email.
// NB : les comptes sont propres à CHAQUE instance (locale et en
// ligne) — l'administrateur les recrée où il veut, le mot de passe
// peut être identique des deux côtés.
// ============================================================
model TeacherAccount {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  loginAttempts Int      @default(0)
  lockedUntil  DateTime?
  tokenHash     String?
  tokenExpiresAt DateTime?
  // Mot de passe oublié : date de la demande (null = aucune) et date
  // à laquelle l'administrateur l'a traitée (le badge disparaît).
  forgotPasswordAt   DateTime?
  forgotPasswordSeenAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
}

// Cas clinique d'application : un énoncé + 3 à 5 QCU résolues en équipe.
// L'affichage étudiant se fait un cas à la fois.
// v2.7.0 : chaque cas est OUVERT par l'enseignant (bouton « Lancer le cas
// clinique N ») — avant son lancement, les étudiants voient une page
// d'attente neutre (ni énoncé, ni questions) : l'enseignant peut expliquer
// chaque cas séparément, sans avance des équipes rapides.
model Case {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String  // ex. « Cas clinique — Mme A., 62 ans »
  intro     String? // énoncé / vignette du cas
  order     Int     @default(0)
  opened    Boolean @default(false) // v2.7.0 : cas lancé par l'enseignant
  updatedAt DateTime? // v2.7.0 : fusion Internet ↔ réseau local

  questions Question[]

  @@index([sessionId])
}

model Team {
  id        String @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String // "Équipe 1", ...
  number    Int
  // v3.0.0 — Compteur de révision PROPRE À L'ÉQUIPE (sondage allégé
  // par équipe) : une réponse tRAT ne concerne que les membres de
  // l'équipe (carte à gratter visible par elle seule). Incrémenter
  // la révision GLOBALE aurait forcé les 150 étudiants de la classe
  // à re-télécharger l'état complet à CHAQUE réponse d'UNE équipe ;
  // avec ce compteur, seuls les membres de l'équipe concernée
  // renouvellent leur état — la tempête de requêtes des grosses
  // classes disparaît. Colonne additive, défaut 0.
  revisionTeam Int @default(0)
  // L'équipe a signalé qu'elle n'a (plus) de réclamation : quand toutes les
  // équipes actives ont répondu, la phase passe automatiquement au feedback.
  appealsDone Boolean @default(false)
  // v2.7.0 : fusion Internet ↔ réseau local (résolution des conflits)
  updatedAt DateTime?

  students   Student[]
  answers    Answer[] // réponses tRAT (par équipe)
  appeals    Appeal[]
  appAnswers AppAnswer[]
}

model Student {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  name      String
  token     String   @unique // jeton étudiant (persistance sur son appareil)
  // Code de reprise personnel (6 caractères) : affiché à l'étudiant après
  // sa première connexion, il permet de récupérer sa séance sur un autre
  // appareil sans pouvoir usurper le compte d'un camarade homonyme.
  // v2.6.0 : à la création, l'étudiant CHOISIT lui-même ce code (4 caractères
  // et plus, chiffres/lettres) — les comptes antérieurs gardent leur code
  // généré automatiquement (6 caractères), parfaitement compatible.
  recoveryCode String  @default("")
  // v2.7.0 : fusion Internet ↔ réseau local (changement d'équipe, etc.)
  updatedAt DateTime?
  // v2.6.0 — questionnaire TBL-SAI : date de soumission (null = pas encore
  // répondu → la note finale et le rang restent masqués) et commentaire
  // libre facultatif transmis avec les réponses.
  saiCompletedAt DateTime?
  saiComment     String?
  createdAt DateTime @default(now())

  answers   Answer[] // réponses iRAT (individuelles)
  peerGiven PeerEval[] @relation("evaluator")
  peerReceived PeerEval[] @relation("evaluated")
  // v2.5.0 : signalements anti-capture (capture suspectée / sortie d'application)
  alerts    AlertEvent[]
  // v2.6.0 : réponses au questionnaire de fin de séance (TBL-SAI)
  saiResponses SaiResponse[]

  @@index([sessionId])
  @@index([teamId])
}

model Question {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text      String
  choices   String // JSON : ["choix A", "choix B", ...]
  correct   Int // index de la bonne réponse
  phase     String  @default("rat") // rat (iRAT + tRAT) | application
  order     Int     @default(0)
  caseId    String? // cas clinique d'application (null = ancien format / question RAT)
  case      Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // v2.7.0 : fusion Internet ↔ réseau local (édition par l'enseignant)
  updatedAt DateTime?

  answers    Answer[]
  appeals    Appeal[]
  appAnswers AppAnswer[]

  @@index([sessionId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // iRAT : étudiant renseigné ; tRAT : équipe renseignée
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  kind       String // irat | trat
  choice     Int
  attempt    Int      @default(1) // tentative (tRAT : 1 à 4)
  isCorrect  Boolean
  score      Float    @default(0) // iRAT : 1 pt ; tRAT : 4 / 2 / 1 / 0
  createdAt  DateTime @default(now())
  // v2.7.0 : fusion Internet ↔ réseau local (réclamation acceptée → 4 pts)
  updatedAt  DateTime?

  // Une seule réponse iRAT par (étudiant, question) : les tentatives tRAT
  // (studentId = null, NULL ≠ NULL en SQL) ne sont pas affectées. Empêche
  // le double comptage d'une réponse iRAT lors de requêtes concurrentes.
  @@unique([studentId, questionId, kind])

  // v2.4.0 — Une seule tentative tRAT par (équipe, question, numéro) :
  // verrou DÉFINITIF contre deux clics vraiment simultanés dans la même
  // équipe (isolation « read committed » de PostgreSQL). Les réponses iRAT
  // (teamId = null) ne sont pas affectées. La route /api/team-answer traduit
  // la violation (P2002) en message clair « double envoi détecté ».
  @@unique([teamId, questionId, kind, attempt])

  @@index([questionId])
  @@index([studentId])
  @@index([teamId])
}

model Appeal {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String // justification de l'équipe
  status     String   @default("pending") // pending | accepted | rejected
  createdAt  DateTime @default(now())
  // v2.7.0 : fusion Internet ↔ réseau local (décision de l'enseignant)
  updatedAt  DateTime?

  @@index([sessionId])
}

model AppAnswer {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice     Int
  text       String? // justification de l'équipe
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([teamId, questionId])
}

model PeerEval {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluatorId String
  evaluator   Student  @relation("evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluatedId String
  evaluated   Student  @relation("evaluated", fields: [evaluatedId], references: [id], onDelete: Cascade)
  score       Int // 1 à 5
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([evaluatorId, evaluatedId])
  @@index([sessionId])
}

// v2.5.0 — Signalements envoyés par la vue étudiant :
//  - 'screenshot'  : combinaison de touches typique d'une capture d'écran
//                    (Impr. écran, Cmd+Shift+3/4/5, Win+Shift+S) — PC uniquement,
//                    aucune API n'existe sur téléphone ;
//  - 'tab_hidden'  : l'application est passée en arrière-plan pendant un test
//                    (fiable sur tous les appareils).
// Ce sont des SUSPICIONS à interpréter, jamais des preuves.
model AlertEvent {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind      String // 'screenshot' | 'tab_hidden'
  // v2.5.1 : épreuve en cours AU MOMENT du signalement (valeur du statut
  // de la séance) — 'irat' | 'trat' | 'application' | 'appeal' | 'peer'…
  // NULL = signalement antérieur à la v2.5.1 (ou phase inconnue) : affiché
  // côté enseignant sous « Autres moments ». Colonne additive, nullable →
  // la mise à jour des bases existantes est autorisée par db-apply.mjs.
  phase      String?
  createdAt DateTime @default(now())

  @@index([studentId, kind, createdAt])
}

// ============================================================
// v2.6.0 — Questionnaire de fin de séance (TBL-SAI)
// Team-Based Learning Student Assessment Instrument
// (© 2010 Heidi A. Mennenga — 33 items standard, 3 sous-échelles).
// Chaque séance possède SA propre copie des items : la création de
// séance sème les 33 items standard (textKey → traductions i18n des
// 7 langues de l'application) ; l'enseignant peut ensuite modifier le
// libellé (champ text : écrase la traduction, affiché tel quel),
// ajouter des items, en supprimer ou réinitialiser le tout.
// ============================================================
model SaiItem {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Sous-échelle : 'accountability' | 'preference' | 'satisfaction'
  subscale  String
  // Clé i18n de l'énoncé standard (null = item ajouté par l'enseignant).
  // Les items standards restent ainsi multilingues tant que l'enseignant
  // ne personnalise pas leur libellé.
  textKey   String?
  // Énoncé personnalisé (null = afficher l'énoncé standard via textKey).
  // Renseigné par l'enseignant : affiché tel quel, dans toutes les langues.
  text      String?
  // Item inversé (formulation négative, ex. « est une perte de temps ») :
  // le calcul des moyennes de sous-échelles inverse la valeur (6 − v).
  reversed  Boolean @default(false)
  order     Int     @default(0)
  createdAt DateTime @default(now())
  // v2.7.0 : fusion Internet ↔ réseau local (édition par l'enseignant)
  updatedAt DateTime?

  responses SaiResponse[]

  @@index([sessionId])
}

model SaiResponse {
  id        String  @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId    String
  item      SaiItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  value     Int // 1 à 5 (Likert)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une seule réponse par (étudiant, item) — le double envoi simultané
  // est impossible, et un étudiant ne peut pas modifier après validation.
  @@unique([studentId, itemId])

  @@index([studentId])
}

// ============================================================
// v2.9.0 — Espace administrateur de l'application
// Une seule ligne (id = "singleton") :
//  - mot de passe administrateur (bcrypt) — vide à l'origine :
//    la première visite de /admin propose de le choisir ;
//  - jeton de session (hash SHA-256 + expiration 12 h) posé en
//    cookie HttpOnly après connexion ;
//  - verrouillage anti force-brute (5 essais → 15 minutes) ;
//  - délai de la synchronisation Internet ↔ réseau local (ms) ;
//  - personnalisations de texte : { "texte d'origine": "texte voulu" }.
//    Elles s'appliquent dans toutes les langues et restent
//    modifiables ou réinitialisables à tout moment.
// ============================================================
model AdminSetting {
  id             String    @id @default("singleton")
  passwordHash   String    @default("")
  loginAttempts  Int       @default(0)
  lockedUntil    DateTime?
  tokenHash      String?
  tokenExpiresAt DateTime?
  syncIntervalMs Int       @default(5000)
  textOverrides  String    @default("{}")
  // v3.0.0 — Domaine institutionnel des emails enseignants (modifiable
  // par l'administrateur si l'établissement change de domaine).
  teacherEmailDomain String @default("@famso.u-sousse.tn")
  // v3.0.0 — Personnalisation de l'apparence : { primary, accent,
  // background, logoIcon, teacherIcon, studentIcon } (JSON, couleurs
  // #hex). "{}" = thème d'origine (vert émeraude).
  theme          String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
